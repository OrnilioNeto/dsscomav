APP_NAME="Plataforma DSS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.com
APP_ASSET_PREFIX=/dsscomav

# BANCO DE DADOS - MySQL (padrão cPanel)
# Pegue os dados no cPanel > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=seu_usuario_banco
DB_USERNAME=seu_usuario_banco
DB_PASSWORD=sua_senha_segura

# Cache, sessão e fila para hospedagem compartilhada
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Domínio usado pelo Sanctum
SANCTUM_STATEFUL_DOMAINS=seu-dominio.com

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Prefixo de cache
CACHE_PREFIX=
