APP_NAME="Plataforma DSS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio.com
APP_KEY=base64:

# BANCO DE DADOS - MySQL (padrão cPanel)
# Pegue os dados no cPanel > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=seu_usuario_banco
DB_USERNAME=seu_usuario_banco
DB_PASSWORD=sua_senha_segura

# Cache e Sessions - em shared hosting use file
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Logs
LOG_CHANNEL=stack

# Não altere
BROADCAST_DRIVER=log
CACHE_PREFIX=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=seu-dominio.com
